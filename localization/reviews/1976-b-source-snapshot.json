      "1976_Carter_Jackson/answers_json/3653@81/description",
      "1976_Ford_Baker/answers_json/3653@83/description",
      "1976_Ford_Anderson/answers_json/3653@83/description",
      "1976_Ford_Connally/answers_json/3653@84/description"
    ]
  },
  {
    "source": "This is a positive step forward for our criminal justice system. Certain crimes, like murder, demand such punishment if true justice is to prevail.",
    "zh": "这是我们刑事司法系统向前迈出的积极一步。如果真正的正义得以伸张，某些罪行，例如谋杀，就需要这样的惩罚。",
    "keys": [
      "1976_Carter_Mondale/answers_json/3654@83/description",
      "1976_Carter_Glenn/answers_json/3654@84/description",
      "1976_Carter_Jackson/answers_json/3654@82/description",
