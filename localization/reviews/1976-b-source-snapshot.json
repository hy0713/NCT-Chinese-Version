      "1976_Carter_Jackson/answers_json/3650@78/description",
      "1976_Ford_Dole/answers_json/3650@85/description",
      "1976_Ford_Baker/answers_json/3650@80/description",
      "1976_Ford_Anderson/answers_json/3650@80/description",
      "1976_Ford_Connally/answers_json/3650@81/description"
    ]
  },
  {
    "source": "Even if permitted, I would hope that our states would move to abolish the death penalty.",
    "zh": "即使允许，我也希望我们的州能够采取行动废除死刑。",
    "keys": [
      "1976_Carter_Mondale/answers_json/3651@80/description",
      "1976_Carter_Glenn/answers_json/3651@81/description",
      "1976_Carter_Jackson/answers_json/3651@79/description",
      "1976_Ford_Baker/answers_json/3651@81/description",
      "1976_Ford_Anderson/answers_json/3651@81/description",
      "1976_Ford_Connally/answers_json/3651@82/description"
    ]
  },
  {
    "source": "I'm opposed to the death penalty overall, but I could support it for a few particularly heinous crimes.",
    "zh": "我总体上反对死刑，但对于一些特别令人发指的罪行我可以支持死刑。",
    "keys": [
      "1976_Carter_Mondale/answers_json/3652@81/description",
      "1976_Carter_Glenn/answers_json/3652@82/description",
      "1976_Carter_Jackson/answers_json/3652@80/description",
      "1976_Ford_Baker/answers_json/3652@82/description",
      "1976_Ford_Anderson/answers_json/3652@82/description",
      "1976_Ford_Connally/answers_json/3652@83/description"
    ]
  },
  {
    "source": "I'm neutral when it comes to the death penalty. This is an issue for the states to decide.",
    "zh": "我对死刑持中立态度。这是各州需要决定的问题。",
    "keys": [
      "1976_Carter_Mondale/answers_json/3653@82/description",
