      "method": "human-full-field",
      "changed": false
    },
    {
      "index": 39,
      "source": "Good way to sound a bit more statesmanlike.",
      "sha256": "a9c47ffcf0e06de0cdacdb9cec2e2fd8e6d8769d38e9f25e7b882ac383e77756",
