      ],
      "method": "human-full-field",
      "changed": false
    },
    {
      "index": 40,
      "source": "This is too much of a 180 on the immigration issue for most people to process.",
      "sha256": "9233c9f12dcbafdcfb3e1ae3a475e9aea474f26203645f6bf44f84999c027a65",
