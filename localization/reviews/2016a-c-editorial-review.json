        "2016a_Trump_Carson/answer_feedback_json/2209@60/answer_feedback"
      ],
      "method": "human-full-field",
      "changed": false
    },
    {
      "index": 43,
      "source": "People detect a subtle change of position in your stance on Syria.",
      "sha256": "8d4f6852f38f00b5ef44879a49a2913b9210a485b0475413ad49671e868d77fe",
