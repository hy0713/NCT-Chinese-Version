        "1916_Wilson_Marshall/answer_feedback_json/1777@40/answer_feedback",
        "1916_Wilson_Baker/answer_feedback_json/1777@40/answer_feedback",
        "1916_Hughes_Fairbanks/answer_feedback_json/1777@11/answer_feedback",
        "1916_Hughes_Burkett/answer_feedback_json/1777@12/answer_feedback"
      ],
      "method": "human-full-field",
      "changed": false
    },
    {
      "index": 67,
      "source": "Urban Democrats are alarmed by your positive support for Prohibition.",
