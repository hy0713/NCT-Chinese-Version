        "1916_Hughes_Burkett/answer_feedback_json/1778@13/answer_feedback"
      ],
      "method": "human-full-field",
      "changed": false
    },
    {
      "index": 68,
      "source": "Many rural Democrats are upset at the strong position you have taken.",
