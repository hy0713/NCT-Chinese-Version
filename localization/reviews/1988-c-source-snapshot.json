      "1988_Dukakis_Bentsen/questions_json/729@3/description",
      "1988_Dukakis_Glenn/questions_json/729@3/description",
      "1988_Dukakis_Gore/questions_json/729@3/description",
      "1988_Dukakis_Jackson/questions_json/729@6/description"
    ]
  },
  {
    "source": "What is your opinion on the selection of Dan Quayle as George Bush's running mate?",
    "zh": "您对选择丹·奎尔作为乔治·布什的竞选搭档有何看法？",
    "keys": [
      "1988_Dukakis_Bentsen/questions_json/732@4/description",
      "1988_Dukakis_Glenn/questions_json/732@4/description",
      "1988_Dukakis_Gore/questions_json/732@5/description",
      "1988_Dukakis_Jackson/questions_json/732@4/description"
    ]
  },
  {
