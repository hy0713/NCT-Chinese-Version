{
  "1844_Clay_Frelinghuysen/questions_json/623@0/description": "民主党人马丁·范布伦曾任总统，直到1841年卸任。他即将巡游全国，拜访各位朋友和政界人物。你是否会邀请他到你的庄园住上几天？",
  "1844_Clay_Frelinghuysen/questions_json/624@1/description": "在接受辉格党总统提名的公开信中，你将着重阐述哪些观点？",
  "1844_Clay_Frelinghuysen/questions_json/625@2/description": "在吞并得克萨斯的问题上，你将采取什么立场？",
  "1844_Clay_Frelinghuysen/questions_json/626@3/description": "你的竞选搭档西奥多·弗里林海森的背景，让国内许多天主教徒深感不安。你会就此发表声明吗？",
  "1844_Clay_Frelinghuysen/questions_json/636@4/description": "《1842年关税法》提高了关税。你们党应当对此持什么立场？",
  "1844_Clay_Frelinghuysen/questions_json/637@5/description": "你是否认为，应当拨出部分关税收入，用于运河、道路等国内公共工程建设？",
  "1844_Clay_Frelinghuysen/questions_json/639@6/description": "你是否支持通过宪法修正案，将总统任期限制为一届？",
  "1844_Clay_Frelinghuysen/questions_json/638@7/description": "你目前对银行制度持什么立场？",
  "1844_Clay_Frelinghuysen/questions_json/634@8/description": "是否应当攻击北方民主党人，指责他们为南方扩张奴隶制提供便利，并与之沆瀣一气？",
  "1844_Clay_Frelinghuysen/questions_json/635@9/description": "南方辉格党人不断受到攻击，被指责与反奴隶制政党为伍。你能否采取什么措施，替他们提供政治上的辩护？",
  "1844_Clay_Frelinghuysen/questions_json/628@10/description": "最近，费城等地的本土主义者与爱尔兰移民之间发生了暴乱和武装冲突。你是否准备谴责这些事件中爱尔兰人的暴力行为？",
  "1844_Clay_Frelinghuysen/questions_json/632@11/description": "你是否仍然支持由联邦政府购买电报专利，并管理这项技术？",
  "1844_Clay_Frelinghuysen/questions_json/629@12/description": "你的亲戚卡修斯·克莱发表了一封信，声称你赞同废奴运动。你会如何回应？",
  "1844_Clay_Frelinghuysen/questions_json/631@13/description": "自由党是一个激进的废奴团体，正在推出第三党候选人。你是否打算对他们展开攻击？",
  "1844_Clay_Frelinghuysen/questions_json/633@14/description": "你与约翰·昆西·亚当斯之间，是否真的达成了一项让他在1825年当上总统的交易——也就是许多人所说的“腐败交易”？",
  "1844_Clay_Frelinghuysen/questions_json/630@15/description": "有人不断攻击你对赛马、饮酒、赌博、与女性闲谈等活动的喜好。对此，你有什么回应？",
  "1844_Clay_Frelinghuysen/questions_json/641@16/description": "除了得克萨斯问题，你总体上是否支持美国扩张——进入俄勒冈、墨西哥其他地区、古巴等地？",
  "1844_Clay_Frelinghuysen/questions_json/640@17/description": "你是否支持取消国会的禁议规则？",
  "1844_Clay_Frelinghuysen/questions_json/647@18/description": "阿贝尔·厄普舒尔在<em>普林斯顿号</em>爆炸事故中不幸身亡后，约翰·卡尔霍恩接任国务卿。泰勒总统的这项任命是否明智？",
  "1844_Clay_Frelinghuysen/questions_json/649@19/description": "你在俄勒冈边界问题上的立场是什么？",
  "1844_Clay_Frelinghuysen/questions_json/642@20/description": "如果一项法律把关税降到不足以保护美国工业免受外国进口商品冲击的水平，你会签署吗？",
  "1844_Clay_Frelinghuysen/questions_json/650@21/description": "约瑟夫·斯密在6月遭到暗杀前，伊利诺伊州当局未能妥善保护他。对此，你有什么批评？",
  "1844_Clay_Frelinghuysen/questions_json/645@22/description": "你是否支持建立全国统一货币的努力？",
  "1844_Clay_Frelinghuysen/questions_json/648@23/description": "撇开个人看法，你是否会签署一项法案，为政府资金设立独立国库？",
  "1844_Clay_Frelinghuysen/questions_json/651@24/description": "大选临近，你们党是否应当把资源和最优秀的演说家集中到某个州？",
  "1844_Clay_Frelinghuysen/answers_json/4193@0/description": "只能拨出极少一部分，用于最有说服力的工程。除此之外，关税应当仅以筹集财政收入为目的。",
  "1844_Clay_Frelinghuysen/answers_json/4154@1/description": "我最好不要显得与民主党领袖过于亲近，尤其是范布伦这样不受欢迎的人。",
  "1844_Clay_Frelinghuysen/answers_json/4155@2/description": "这纯粹是私人邀请。我们是朋友。何况，这或许也能缓和纽约州一些人对我参选的反对。",
  "1844_Clay_Frelinghuysen/answers_json/4156@3/description": "我反对以任何形式吞并得克萨斯。这会重新挑起已平息的争议，分散国家对经济发展等重要政治议题的注意力。",
  "1844_Clay_Frelinghuysen/answers_json/4157@4/description": "我支持吞并得克萨斯，前提是接纳该州入联邦的同时，也接纳一个自由州。我会简要说明，我在其他议题上的立场众所周知，而且没有改变。",
  "1844_Clay_Frelinghuysen/answers_json/4158@5/description": "我将完全不提得克萨斯。接受提名的信将主要阐明我的经济原则，包括国家银行、关税和国内公共工程。",
  "1844_Clay_Frelinghuysen/answers_json/4159@6/description": "我将在得克萨斯问题上采取折中立场：只要吞并不会引发与墨西哥的战争，也不会招致国内任何地区的强烈反对，我就支持。",
  "1844_Clay_Frelinghuysen/answers_json/4160@7/description": "这场讨论已经令人厌烦，不过让我重申：我支持吞并得克萨斯。",
  "1844_Clay_Frelinghuysen/answers_json/4161@8/description": "这场讨论已经令人厌烦，不过我仍将主张以温和方式解决这个问题。",
  "1844_Clay_Frelinghuysen/answers_json/4162@9/description": "这场讨论已经令人厌烦，不过让我重申：我反对吞并得克萨斯。",
  "1844_Clay_Frelinghuysen/answers_json/4163@10/description": "我们需要回应这些担忧，明确声明：辉格党支持现行入籍法，不主张本土主义。",
  "1844_Clay_Frelinghuysen/answers_json/4164@11/description": "我们不要就此发表声明。双方都有太多人可能因此受到冒犯。",
  "1844_Clay_Frelinghuysen/answers_json/4165@12/description": "我们当然谴责暴乱和违法行为，但也支持尝试修改入籍法。",
  "1844_Clay_Frelinghuysen/answers_json/4168@13/description": "我们应当谴责这些新来的爱尔兰人显然目无法纪的行为，并反思是否应该重新考虑宽松的入籍政策。",
  "1844_Clay_Frelinghuysen/answers_json/4169@14/description": "我们最好不要就此发表任何声明。",
  "1844_Clay_Frelinghuysen/answers_json/4170@15/description": "等过了几天，人们怒气稍平，我们再重申对现行入籍法的支持。",
  "1844_Clay_Frelinghuysen/answers_json/4171@16/description": "我们必须发表一封信，澄清只有在奴隶主获得公平补偿、得到合理的提前通知，而且获释奴隶可以被送往非洲殖民安置的条件下，我们才支持废奴。",
  "1844_Clay_Frelinghuysen/answers_json/4172@17/description": "我们必须立即抨击卡修斯·克莱的言论，指出那是恶意编造的谎言。在这场争论中，我绝不是废奴主义者。",
  "1844_Clay_Frelinghuysen/answers_json/4173@18/description": "我不会作出回应，让这封信显得值得认真对待。",
  "1844_Clay_Frelinghuysen/answers_json/4174@19/description": "美国有不少地方的男人都喜欢这类活动。反正，北方清教徒的选票我们都会拿到。",
  "1844_Clay_Frelinghuysen/answers_json/4175@20/description": "我参与了这个时代常见的消遣，或许比多数人还多一点，但这从来没有影响我履行公职。",
  "1844_Clay_Frelinghuysen/answers_json/4176@21/description": "我早就料到会有这种攻击，所以过去一年左右，确实已努力减少这些消遣。我相信，一个人想改变自己的行为，永远不算太晚。",
  "1844_Clay_Frelinghuysen/answers_json/4177@22/description": "我们对他们的任何攻击，都只会让这个团体更加出名。还是专心开展我们自己的竞选吧。",
  "1844_Clay_Frelinghuysen/answers_json/4178@23/description": "托马斯·伯尼是民主党的傀儡，企图煽动情绪、分裂我们党。如果人们想把这场大选拱手让给詹姆斯·K.·波尔克，尽管投票给他好了。",
  "1844_Clay_Frelinghuysen/answers_json/4179@24/description": "我坚决反对吞并得克萨斯，反对扩张奴隶制。我认为，应当让伯尼的追随者清楚这一点。",
  "1844_Clay_Frelinghuysen/answers_json/4180@25/description": "我坚信，发展电报线路应当与运河、港口、铁路一样，成为国家应当承担的事务。",
  "1844_Clay_Frelinghuysen/answers_json/4181@26/description": "在整个政治生涯中，我一直支持国内公共工程，但电报线路是另一回事。我相信，私人可以建设这些线路。",
  "1844_Clay_Frelinghuysen/answers_json/4182@27/description": "我们不要在这个问题上发表容易引发分裂的言论。反正公众也没有迫切要求我表态。",
  "1844_Clay_Frelinghuysen/answers_json/4183@28/description": "我不知道，一个人要否认多少次不公的指控，才会感到疲惫。",
  "1844_Clay_Frelinghuysen/answers_json/4184@29/description": "我反对吞并得克萨斯的立场已经众所周知，不过我们可以更明确地指出，这一举动与扩张奴隶制之间的联系。",
  "1844_Clay_Frelinghuysen/answers_json/4185@30/description": "我们应当抨击北方民主党人在关税和国内公共工程问题上的反对立场，或其反复摇摆的态度。他们在这场争论中站不住脚。",
  "1844_Clay_Frelinghuysen/answers_json/4186@31/description": "我与波尔克先生一样支持吞并得克萨斯。任何暗示并非如此的说法，都是赤裸裸的谎言。",
  "1844_Clay_Frelinghuysen/answers_json/4187@32/description": "我反对任何地区的激进主义，也包括反奴隶制的激进主义。辉格党是全国性政党，有一套让各地区平等受益的全国纲领。",
  "1844_Clay_Frelinghuysen/answers_json/4188@33/description": "我们坚定支持这项关税。它是泰勒先生那个所谓总统任期中，为数不多的积极成果之一。",
  "1844_Clay_Frelinghuysen/answers_json/4189@34/description": "关税的首要目的应当是筹集财政收入。不过，如果关税政策<em>附带</em>产生少量保护作用，也是可以接受的。",
  "1844_Clay_Frelinghuysen/answers_json/4190@35/description": "我们应当避免在这项关税上采取鲜明立场。党内在这个问题上，两边都有人支持。",
  "1844_Clay_Frelinghuysen/answers_json/4191@36/description": "我们必须废除这项关税，改用低得多的税率。我支持自由贸易和低关税。",
  "1844_Clay_Frelinghuysen/answers_json/4192@37/description": "这是现行关税政策的主要目标之一。如果当选总统，我会支持一项有力的基础设施建设计划。",
  "1844_Clay_Frelinghuysen/answers_json/4194@38/description": "我认为，由联邦政府推行国内公共工程计划，既不合宪，也不明智。",
  "1844_Clay_Frelinghuysen/answers_json/4195@39/description": "我主张设立一家国家银行，大体类似于已经撤销的美国第二银行。",
  "1844_Clay_Frelinghuysen/answers_json/4196@40/description": "我支持国家银行或独立国库，哪一种能获得更多支持，就采用哪一种。我会要求任何国家银行都在每个州设立分行。",
  "1844_Clay_Frelinghuysen/answers_json/4197@41/description": "我绝不会支持国家银行，但我主张设立独立国库，让联邦资金不致卷入地方上的投机活动。",
  "1844_Clay_Frelinghuysen/answers_json/4198@42/description": "我支持现行自由银行制度，看不出有什么必要让国库业务与各州特许设立的银行隔离开来。",
  "1844_Clay_Frelinghuysen/answers_json/4199@43/description": "这是遏制行政部门越权和滥权的必要措施。",
  "1844_Clay_Frelinghuysen/answers_json/4200@44/description": "我不支持为此修宪，但我个人会承诺不竞选连任。",
  "1844_Clay_Frelinghuysen/answers_json/4201@45/description": "我认为，眼下没有必要采取这项措施。",
  "1844_Clay_Frelinghuysen/answers_json/4202@46/description": "国会必须有序运作，不能放下正事，花时间受理考虑不周的请愿。我支持禁议规则。",
  "1844_Clay_Frelinghuysen/answers_json/4203@47/description": "无论我们如何看待奴隶制，国会剥夺人民向政府请愿的权利，都是不民主的。我认为应当取消禁议规则。",
  "1844_Clay_Frelinghuysen/answers_json/4204@48/description": "我们不打算在竞选中评论禁议规则。",
  "1844_Clay_Frelinghuysen/answers_json/4205@49/description": "我反对吞并得克萨斯。为表明这一立场确实出于地域偏见，我也反对向俄勒冈或其他地区扩张。",
  "1844_Clay_Frelinghuysen/answers_json/4206@50/description": "我认为，美国应当遵循“天定命运”的理想，在条件允许的地方扩张。",
  "1844_Clay_Frelinghuysen/answers_json/4207@51/description": "如果我是总统，就不得不否决这样的措施。",
  "1844_Clay_Frelinghuysen/answers_json/4208@52/description": "撇开我的个人看法，除非法律违宪，否则总统不应凌驾于国会意志之上。",
  "1844_Clay_Frelinghuysen/answers_json/4209@53/description": "我会欣然签署这样的法案，使其成为法律。",
  "1844_Clay_Frelinghuysen/answers_json/4216@54/description": "我支持国家银行。自1837年以来，我们的货币陷入一片混乱，这就是支持设立国家银行的一项有力理由。",
  "1844_Clay_Frelinghuysen/answers_json/4217@55/description": "只有在不必特许设立新国家银行的情况下，我才会支持。",
  "1844_Clay_Frelinghuysen/answers_json/4218@56/description": "我支持独立国库，但不支持由它发行全国性货币。",
  "1844_Clay_Frelinghuysen/answers_json/4219@57/description": "现行制度比任何可能提出的替代方案都更民主。让私营银行根据各自的实力和经营状况发行货币吧。",
  "1844_Clay_Frelinghuysen/answers_json/4222@58/description": "这是我一生所见最欠考虑的决定之一。",
  "1844_Clay_Frelinghuysen/answers_json/4223@59/description": "我们没有打算评论泰勒总统的内阁任命。",
  "1844_Clay_Frelinghuysen/answers_json/4224@60/description": "独立国库是个折中办法，旨在掩饰打击美国第二银行所造成的灾难。",
  "1844_Clay_Frelinghuysen/answers_json/4225@61/description": "我更倾向于国家银行，但也愿意签署设立独立国库的法案。",
  "1844_Clay_Frelinghuysen/answers_json/4226@62/description": "设立独立国库，将是我担任总统期间的重点措施之一。",
  "1844_Clay_Frelinghuysen/answers_json/4227@63/description": "我支持现行银行制度，不会支持任何考虑不周、试图集中控制国家金融的做法。",
  "1844_Clay_Frelinghuysen/answers_json/4228@64/description": "在这个问题上，我们也要像在其他问题上一样强硬。“北纬54度40分，否则开战！”",
  "1844_Clay_Frelinghuysen/answers_json/4229@65/description": "我们需要与英国谈判，达成永久协议，将俄勒冈领地的部分或全部土地划归美国。",
  "1844_Clay_Frelinghuysen/answers_json/4230@66/description": "只要美国保住哥伦比亚河以南及以东的土地，我就支持达成协议。",
  "1844_Clay_Frelinghuysen/answers_json/4231@67/description": "不管我们个人怎么看，一个宗教领袖兼总统候选人竟然会被暴民杀害，总是令人忧虑的。",
  "1844_Clay_Frelinghuysen/answers_json/4232@68/description": "我们不打算在竞选中评论这个问题。",
  "1844_Clay_Frelinghuysen/answers_json/4233@69/description": "纽约州",
  "1844_Clay_Frelinghuysen/answers_json/4234@70/description": "宾夕法尼亚州",
  "1844_Clay_Frelinghuysen/answers_json/4235@71/description": "俄亥俄州",
  "1844_Clay_Frelinghuysen/answers_json/4237@72/description": "俄勒冈与得克萨斯是不同的问题。对于俄勒冈，我们已经拥有合法的领土主张。",
  "1844_Clay_Frelinghuysen/answers_json/4236@73/description": "弗吉尼亚州",
  "1844_Clay_Frelinghuysen/states_json/382@0/name": "阿拉巴马州",
  "1844_Clay_Frelinghuysen/states_json/383@1/name": "阿肯色州",
  "1844_Clay_Frelinghuysen/states_json/384@2/name": "康涅狄格州",
  "1844_Clay_Frelinghuysen/states_json/385@3/name": "特拉华州",
  "1844_Clay_Frelinghuysen/states_json/386@4/name": "佐治亚州",
  "1844_Clay_Frelinghuysen/states_json/387@5/name": "伊利诺伊州",
  "1844_Clay_Frelinghuysen/states_json/388@6/name": "印第安纳州",
  "1844_Clay_Frelinghuysen/states_json/389@7/name": "肯塔基州",
  "1844_Clay_Frelinghuysen/states_json/390@8/name": "路易斯安那州",
  "1844_Clay_Frelinghuysen/states_json/391@9/name": "缅因州",
  "1844_Clay_Frelinghuysen/states_json/392@10/name": "马里兰州",
  "1844_Clay_Frelinghuysen/states_json/393@11/name": "马萨诸塞州",
  "1844_Clay_Frelinghuysen/states_json/394@12/name": "密歇根州",
  "1844_Clay_Frelinghuysen/states_json/395@13/name": "密西西比州",
